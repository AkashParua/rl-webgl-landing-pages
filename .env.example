# Copy to .env and fill in. Never commit .env

# Provider: ollama | openai | groq | openrouter | custom | together
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

